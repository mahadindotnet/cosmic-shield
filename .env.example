# Default: SQLite file (zero-config local dev)
DATABASE_URL=file:./data/cosmic-shield.db

# Optional Postgres (docker compose up -d)
# DATABASE_URL=postgresql://cosmic:cosmic@localhost:5432/cosmic_shield

# --- Login (crew ID + PIN) -------------------------------------------------
# Both are required: the server refuses to start without them.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs the session cookie. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string
# Server-side pepper: PINs are stored as bcrypt(HMAC-SHA256(PIN_PEPPER, pin)).
# Changing it invalidates every stored PIN; run `npm run db:seed` afterwards.
PIN_PEPPER=replace-with-a-different-long-random-string
# Session cookies are Secure by default (works on http://localhost).
# Set to false only to test over plain HTTP on a LAN IP (e.g. from a phone).
# COOKIE_SECURE=false
# Show the "Demo accounts" box on /login (set to false for a real deployment).
# SHOW_DEMO_ACCOUNTS=true

# NASA open APIs (npm run data:fetch). Get a free key at https://api.nasa.gov
# NASA_API_KEY=
