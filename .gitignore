# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
/data/cosmic-shield.db
/data/cosmic-shield.db-*

# playwright
/playwright-report/
/test-results/
/playwright-report/

# local artifacts
claude-share-page.txt
claude-share-snapshot.json
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e test database and test dev-server build output
/data/cosmic-shield.test.db
/data/cosmic-shield.test.db-*
/.next-test/

# Playwright saved sign-in state
/e2e/.auth/

# Design inspiration and source photos (not used by the app; never commit them)
design-ref/
feature_img/

# Uploaded photos (private health data; never commit)
/uploads/
/uploads-test/
